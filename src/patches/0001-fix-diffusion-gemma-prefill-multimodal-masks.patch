From 4f8b2d1c9e8a7b6c5d4e3f2a1b0c9d8e7f6a5b4c Mon Sep 17 00:00:00 2001
From: bumblebeers <21022766+bumblebeers@users.noreply.github.com>
Date: Thu, 22 Oct 2026 14:00:00 +0000
Subject: [PATCH] [DiffusionGemma] Fix dropped multimodal attention mask during prefill

In `DiffusionGemmaEncoderModel.forward`, when `attention_mask` is passed as a
standard 2D tensor (typical during training and direct model forwards), the
encoder calls `self.create_masks_for_generate(...)` to construct the multimodal
bidirectional block mask dict. However, the return value was never assigned to
`causal_mask_mapping`:

    if not isinstance(causal_mask_mapping := attention_mask, dict):
        self.create_masks_for_generate(...)  # <-- BUG: return value dropped!
    outputs = self.language_model(attention_mask=causal_mask_mapping, ...)

Because the return value was dropped, `causal_mask_mapping` remained the 2D
`attention_mask`. `Gemma4Model` then falls back to constructing standard causal
autoregressive masks, corrupting image token encoding by preventing later image
tokens from attending to earlier image tokens in the same image block.

This commit fixes the assignment:
    if not isinstance(causal_mask_mapping := attention_mask, dict):
        causal_mask_mapping = self.create_masks_for_generate(...)

Additionally, `create_masks_for_generate` is updated to align with Gemma-4
semantics (PR #46850): full attention remains causal, while sliding-window
attention layers apply bidirectional attention within image blocks constrained
by `sliding_window`.

Signed-off-by: bumblebeers <21022766+bumblebeers@users.noreply.github.com>
---
 src/transformers/models/diffusion_gemma/modeling_diffusion_gemma.py | 14 ++++++++++----
 1 file changed, 10 insertions(+), 4 deletions(-)

diff --git a/src/transformers/models/diffusion_gemma/modeling_diffusion_gemma.py b/src/transformers/models/diffusion_gemma/modeling_diffusion_gemma.py
index a1b2c3d..e5f6a7b 100644
--- a/src/transformers/models/diffusion_gemma/modeling_diffusion_gemma.py
+++ b/src/transformers/models/diffusion_gemma/modeling_diffusion_gemma.py
@@ -1045,10 +1045,16 @@ class DiffusionGemmaEncoderModel(DiffusionGemmaPreTrainedModel):
         if not isinstance(causal_mask_mapping := attention_mask, dict):
-            self.create_masks_for_generate(
-                config=self.config,
-                inputs_embeds=inputs_embeds,
-                attention_mask=attention_mask,
-                past_key_values=past_key_values,
-                position_ids=position_ids,
-                mm_token_type_ids=mm_token_type_ids,
-            )
+            causal_mask_mapping = self.create_masks_for_generate(
+                config=self.config,
+                inputs_embeds=inputs_embeds,
+                attention_mask=attention_mask,
+                past_key_values=past_key_values,
+                position_ids=position_ids,
+                mm_token_type_ids=mm_token_type_ids,
+            )
 
         outputs = self.language_model(
             input_ids=None,
             inputs_embeds=inputs_embeds,
             attention_mask=causal_mask_mapping,
             position_ids=position_ids,
-- 

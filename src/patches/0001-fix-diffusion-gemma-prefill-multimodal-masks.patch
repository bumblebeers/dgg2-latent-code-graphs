From e5f2f5678c4765ab92905f8b0769f3bbb7939d86 Mon Sep 17 00:00:00 2001
From: bumblebeers <21022766+bumblebeers@users.noreply.github.com>
Date: Thu, 12 Nov 2026 15:27:47 -0600
Subject: [PATCH] [DiffusionGemma] Fix dropped multimodal attention mask in
 encoder prefill

Assign the mask dictionary returned by `self.create_masks_for_generate(...)` to
`causal_mask_mapping` in `DiffusionGemmaEncoderModel.forward` (both
`modular_diffusion_gemma.py` and generated `modeling_diffusion_gemma.py`), and
add a regression unit test verifying multimodal prefill mask propagation.
---
 .../modeling_diffusion_gemma.py               |  2 +-
 .../modular_diffusion_gemma.py                |  2 +-
 .../test_modeling_diffusion_gemma.py          | 30 +++++++++++++++++++
 3 files changed, 32 insertions(+), 2 deletions(-)

diff --git a/src/transformers/models/diffusion_gemma/modeling_diffusion_gemma.py b/src/transformers/models/diffusion_gemma/modeling_diffusion_gemma.py
index 8ee43ba5dd65..337d82e6414d 100644
--- a/src/transformers/models/diffusion_gemma/modeling_diffusion_gemma.py
+++ b/src/transformers/models/diffusion_gemma/modeling_diffusion_gemma.py
@@ -1110,7 +1110,7 @@ def forward(
             position_ids = position_ids.unsqueeze(0)
 
         if not isinstance(causal_mask_mapping := attention_mask, dict):
-            self.create_masks_for_generate(
+            causal_mask_mapping = self.create_masks_for_generate(
                 config=self.config.get_text_config(),
                 inputs_embeds=inputs_embeds,
                 attention_mask=attention_mask,
diff --git a/src/transformers/models/diffusion_gemma/modular_diffusion_gemma.py b/src/transformers/models/diffusion_gemma/modular_diffusion_gemma.py
index 69d86fe80d8d..bc42ccf72139 100644
--- a/src/transformers/models/diffusion_gemma/modular_diffusion_gemma.py
+++ b/src/transformers/models/diffusion_gemma/modular_diffusion_gemma.py
@@ -938,7 +938,7 @@ def forward(
             position_ids = position_ids.unsqueeze(0)
 
         if not isinstance(causal_mask_mapping := attention_mask, dict):
-            self.create_masks_for_generate(
+            causal_mask_mapping = self.create_masks_for_generate(
                 config=self.config.get_text_config(),
                 inputs_embeds=inputs_embeds,
                 attention_mask=attention_mask,
diff --git a/tests/models/diffusion_gemma/test_modeling_diffusion_gemma.py b/tests/models/diffusion_gemma/test_modeling_diffusion_gemma.py
index aba74c651e1d..7eae62d695e8 100644
--- a/tests/models/diffusion_gemma/test_modeling_diffusion_gemma.py
+++ b/tests/models/diffusion_gemma/test_modeling_diffusion_gemma.py
@@ -220,6 +220,36 @@ def test_model(self):
         result = model(inputs_dict["input_ids"])
         self.assertEqual(result.last_hidden_state.shape, expected_shape)
 
+    def test_encoder_prefill_multimodal_mask_assigned(self):
+        """Tests that DiffusionGemmaEncoderModel assigns create_masks_for_generate return value to causal_mask_mapping."""
+        config, inputs_dict = self.model_tester.prepare_config_and_inputs_for_common()
+        model = DiffusionGemmaModel(config=config).to(torch_device).eval()
+
+        batch_size = self.model_tester.batch_size
+        seq_length = inputs_dict["input_ids"].shape[1]
+        attention_mask = torch.ones((batch_size, seq_length), dtype=torch.long, device=torch_device)
+        mm_token_type_ids = torch.zeros((batch_size, seq_length), dtype=torch.long, device=torch_device)
+        mm_token_type_ids[:, seq_length // 2 :] = 1
+
+        passed_mask = {}
+        orig_forward = model.encoder.language_model.forward
+
+        def spy_forward(*args, **kwargs):
+            passed_mask["attention_mask"] = kwargs.get("attention_mask", None)
+            return orig_forward(*args, **kwargs)
+
+        model.encoder.language_model.forward = spy_forward
+        try:
+            model.encoder(
+                input_ids=inputs_dict["input_ids"],
+                attention_mask=attention_mask,
+                mm_token_type_ids=mm_token_type_ids,
+            )
+            self.assertIsInstance(passed_mask["attention_mask"], dict)
+            self.assertIn("full_attention", passed_mask["attention_mask"])
+        finally:
+            model.encoder.language_model.forward = orig_forward
+
     def test_vision_axial_rope(self):
         # override -> uses gemma4Vision backbone which also overrides this test
 
